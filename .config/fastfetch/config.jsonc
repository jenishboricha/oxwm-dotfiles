{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/images/seaturtle2.txt",
    "color": {
      "1": "magenta",
      "2": "cyan",
      "3": "blue",
      "4": "yellow"
    },
    "padding": {
      "top": 2,
      "right": 6
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "magenta",
      "title": "magenta"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": "󰣇 ",
      "format": "Arch Linux"
    },
    {
      "type": "shell",
      "key": ">_",
      "format": "bash + alacritty"
    },
    {
      "type": "wm",
      "key": " ",
      "format": "oxwm (x11)"
    },
    {
      "type": "custom",
      "key": "󰉼 ",
      "format": "Rosepuccin"
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "format": "12th Gen Intel(R) i5-12450H"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "hideType": "integrated",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": " ",
      "format": "{1} / {2}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
